# Copy to .env and fill with your provider's credentials. Keep this file server-side.
AI_API_KEY=
# API base ending in /v1 when required by the provider; do not append /chat/completions.
AI_BASE_URL=
AI_MODEL=

# Optional image-capable model for selected training screenshots. Separate from plan generation.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Account service. Production requires PostgreSQL, explicit Alembic migration and a strong secret.
APP_ENV=development
DATABASE_URL=
AUTH_SECRET=
REGISTRATION_OPEN=false
AUTH_INVITE_CODE=
APP_SUPPORT_EMAIL=

# WeChat Open Platform MOBILE app (not a Mini Program / public-account AppID).
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Verification mail. The outbox worker scripts/send_mail.py delivers queued messages.
SMTP_HOST=
SMTP_PORT=465
SMTP_SSL=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional PubMed request identity. Research feed defaults off; enable in admin UI.
NCBI_CONTACT_EMAIL=
NCBI_API_KEY=

# Reviewed public knowledge only. Assets are pinned by backend/data/knowledge_models_manifest.json.
KNOWLEDGE_MODEL_DIR=
KNOWLEDGE_CPU_THREADS=1
KNOWLEDGE_RETRIEVAL_MODE=hybrid_rerank

# Optional Redis cache. Empty uses data/redis-cache.json if locally configured.
# Non-loopback hosts require rediss:// (TLS); never put credentials in Git.
REDIS_URL=
REDIS_CACHE_ENABLED=true
REDIS_CACHE_NAMESPACE=lianban:cache:v1

# Agent funnel: rules fast path, pinned local encoder for ambiguous messages.
# "rules" disables semantic inference; uncertain routes keep the general harness.
AGENT_ROUTING_MODE=hybrid
# Optional native decision layer. Uses only these dedicated provider credentials.
# auto chooses OpenAI when OPENAI_API_KEY is set, otherwise TypeSafe, otherwise local.
AGENT_DECISION_PROVIDER=auto
AGENT_DECISION_MODEL=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
