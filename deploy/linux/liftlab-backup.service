[Unit]
Description=Back up LiftLab database and uploaded files
After=liftlab.service

[Service]
Type=oneshot
User=liftlab
Group=liftlab
EnvironmentFile=/etc/liftlab/liftlab.env
ExecStart=/opt/liftlab/current/.venv/bin/python /opt/liftlab/current/scripts/backup_data.py --data-dir /var/lib/liftlab --backup-dir /var/backups/liftlab --keep 7
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/liftlab
