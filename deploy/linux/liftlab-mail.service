[Unit]
Description=Deliver LiftLab verification mail
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=liftlab
Group=liftlab
WorkingDirectory=/opt/liftlab/current
Environment=FIT_DATA_DIR=/var/lib/liftlab
EnvironmentFile=/etc/liftlab/liftlab.env
ExecStart=/opt/liftlab/current/.venv/bin/python /opt/liftlab/current/scripts/send_mail.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
